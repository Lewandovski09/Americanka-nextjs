# ============================================
# AMERICANKA — Environment Variables
# ============================================
# On Vercel, paste these into Project Settings -> Environment Variables.
# Locally, copy this file to .env.local for testing.

# ---- Supabase ----
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ---- Telegram Bot ----
# Get this from @BotFather on Telegram (see README for steps)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Any random string you generate yourself, then pass to setWebhook as
# secret_token. Telegram echoes it back on every update so we can tell a
# real update from a forged one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=3265315342563461345234764256231516324724356
# Bot username WITHOUT the @ — used to build the t.me deep link in the
# browser, so it must be a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AmericankaVerifyBot

# ---- Gmail (for email verification codes) ----
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
