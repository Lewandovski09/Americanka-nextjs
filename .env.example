# ============================================
# AMERICANKA — Environment Variables
# ============================================
# On Vercel, paste these into Project Settings -> Environment Variables.
# Locally, copy this file to .env.local for testing.

# ---- Supabase ----
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# ---- Telegram Bot ----
# Get this from @BotFather on Telegram (see README for steps)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Any random string you generate yourself, then pass to setWebhook as
# secret_token. Telegram echoes it back on every update so we can tell a
# real update from a forged one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Bot username WITHOUT the @ — used to build the t.me deep link in the
# browser, so it must be a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=AmericankaVerifyBot
# The club's channel for «Оголосити в Telegram» (new tournament card):
# @channel_name or the numeric -100… id. The bot must be an ADMIN of the
# channel with the right to post. Empty → @BV_here_we_go; «-» → no
# channel post (players still get it in the bot).
TELEGRAM_CHANNEL_ID=@BV_here_we_go

# ---- Sentry (error monitoring) ----
# Optional. Create a free project at https://sentry.io, then paste its
# DSN here. Without it, Sentry.init() is a documented no-op — nothing
# is sent, nothing breaks.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# ---- Rate limiting (optional, recommended on Vercel) ----
# Vercel runs the app as many instances at once; with these set, every
# instance shares one request counter (Upstash Redis, free tier is
# enough: Vercel -> Storage -> Upstash). Without them each instance
# counts on its own — the site still works, the limit is just looser.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Site address (optional) ----
# Used for absolute links in link previews (Telegram / Viber cards).
# On Vercel the production address is picked up automatically; set this
# only if the site lives on your own domain.
NEXT_PUBLIC_SITE_URL=
# Other addresses of the same site (comma list) — people who installed the
# app or signed in there are found by the Telegram links too
# (lib/server/openInApp). The project's two Vercel addresses are always
# included; add a custom domain here if you get one.
SITE_ALIASES=
